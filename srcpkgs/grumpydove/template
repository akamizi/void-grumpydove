# Template file for 'grumpydove'
pkgname=grumpydove
version=1.0.0rc12
revision=1
archs="x86_64*"
wrksrc=grumpydove
hostmakedepends="gcc-ada gprbuild"
makedepends="qt6-base-devel libetpan-devel gpgme-devel libcurl-devel
 gnutls-devel libxml2-devel hunspell-devel jansson-devel"
depends="gnupg bogofilter ca-certificates"
short_desc="Mail client in the manner of Eudora Pro, written in Ada and Qt"
maintainer="Maurizio Cavalletti <maurizio@akabit.it>"
license="EUPL-1.2"
homepage="https://git.keinpfusch.net/loweel/grumpydove"
# Upstream tags are v1.0.0-beta11, v1.0.0-rc12; xbps-src forbids "-" and "_" in
# versions, so 1.0.0beta11, 1.0.0rc12: the tag gets its "-" back.
_tag=${version/alpha/-alpha}
_tag=${_tag/beta/-beta}
_tag=${_tag/rc/-rc}
distfiles="${homepage}/archive/v${_tag}.tar.gz>grumpydove-${version}.tar.gz"
checksum=9990263c2956837c2dbaaa84cf99878611f0c490f48a4b8fa6cdaa16cf1f0750
nocross=yes

do_build() {
	gprbuild -P grumpydove.gpr -j${XBPS_MAKEJOBS} -p \
		-XQT_INCLUDE=/usr/include/qt6
}

do_install() {
	# The program looks for its icons in ../icons from its own directory.
	vinstall bin/grumpydove 755 usr/lib/grumpydove/bin
	# Gear.png arrived after beta11: install it only where the tag has it.
	for f in icons/*.bmp icons/Gear.png; do
		[ -f "$f" ] || continue
		vinstall "$f" 644 usr/lib/grumpydove/icons
	done
	vmkdir usr/bin
	ln -s ../lib/grumpydove/bin/grumpydove "${DESTDIR}/usr/bin/grumpydove"
	vinstall icons/grumpydove.png 644 usr/share/icons/hicolor/512x512/apps
	vinstall "${FILESDIR}/grumpydove.desktop" 644 usr/share/applications

	vlicense LICENSE.md
	vlicense icons/LICENSE LICENSE.icons
	vlicense third_party/litehtml/LICENSE LICENSE.litehtml
	vlicense third_party/litehtml/src/gumbo/LICENSE LICENSE.gumbo
}
